{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WJB M0 Probe",
  "version": "../package.json",
  "identifier": "com.chs2147.workjourneyboard.m0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Work Journey Board — M0 설치 검증", "width": 980, "height": 860, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "chs2147",
    "shortDescription": "Work Journey Board M0 설치 검증",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "languages": ["Korean", "English"], "displayLanguageSelector": false }
    }
  }
}
