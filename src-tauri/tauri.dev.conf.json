{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Journey Board DEV",
  "identifier": "com.chs2147.workjourneyboard.dev",
  "mainBinaryName": "work-journey-board-dev",
  "bundle": {
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons-dev/icon.ico"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Work Journey Board DEV",
        "width": 560,
        "height": 340,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "shadow": true,
        "focus": true,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "main",
        "visible": false,
        "dragDropEnabled": false,
        "title": "Work Journey Board DEV",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#faf9f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  }
}
